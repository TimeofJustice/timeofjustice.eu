# https://editorconfig.org
# Read by VS Code (with the EditorConfig extension) and natively by
# JetBrains IDEs. Keeps the editor in sync with the formatters.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Ruff formats Python with 4 spaces
[*.py]
indent_size = 4
max_line_length = 170

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab
